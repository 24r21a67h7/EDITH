<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/edith_background">

    <!-- EDITH Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="48sp"
        android:textColor="@color/edith_accent"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <!-- Status indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status_offline"
        android:textSize="16sp"
        android:textColor="@color/edith_text_secondary"
        android:layout_marginBottom="48dp" />

    <!-- Activate button (push-to-talk) -->
    <Button
        android:id="@+id/activateButton"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:text="@string/activate"
        android:textSize="18sp"
        android:textColor="@color/edith_text_primary"
        android:backgroundTint="@color/edith_accent"
        android:layout_marginBottom="24dp" />

    <!-- Service start/stop button -->
    <Button
        android:id="@+id/serviceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_edith"
        android:textSize="14sp"
        android:textColor="@color/edith_text_primary"
        android:backgroundTint="@color/edith_surface"
        android:layout_marginBottom="32dp" />

    <!-- Setup action (permission / speech pack / voice data), shown only when something needs fixing -->
    <Button
        android:id="@+id/setupButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="@color/edith_text_primary"
        android:backgroundTint="@color/edith_warning"
        android:layout_marginBottom="24dp" />

    <!-- Setup checklist / last issue (never shows recognized speech) -->
    <TextView
        android:id="@+id/responseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/edith_text_secondary"
        android:gravity="start"
        android:fontFamily="monospace"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
